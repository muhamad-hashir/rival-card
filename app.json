{
  "expo": {
    "name": "Rival Card",
    "slug": "rival-card",
    "version": "1.0.0",
    "scheme": "rivalcard",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rivalcard.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E1B4B"
      }
    },
    "androidStatusBar": {
      "hidden": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn expo.modules.**\n-keep class expo.modules.** { *; }\n-dontwarn com.facebook.react.**\n-keep class com.facebook.react.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "0e1cd1b0-4a09-41f5-8ead-93a31c74bd48"
      },

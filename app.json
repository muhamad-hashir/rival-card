{
  "expo": {
    "name": "Rival Card",
    "slug": "rival-card",
    "version": "1.1.1",
    "scheme": "rivalcard",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hashir.rivalcard",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "androidStatusBar": {
      "hidden": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn expo.modules.**\n-keep class expo.modules.** { *; }\n-dontwarn com.facebook.react.**\n-keep class com.facebook.react.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-audio",
      "@react-native-google-signin/google-signin",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],

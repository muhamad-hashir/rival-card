{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -Dandroid.enableR8.fullMode=false -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "EXPO_NO_MINIFY": "1"
      }
    }
  }
}
